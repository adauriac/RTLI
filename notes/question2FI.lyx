\begin_layout Subsection*
In the classical limit of the RTLI
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
\mathcal{H}=-\sum^{L}_{i=1}\left|J_{i}\right|\sigma_{i}\sigma_{i+1}-\sum^{L}_{i=1}h_{i}\sigma_{i}
\]

\end_inset

with 
\begin_inset Formula $L$
\end_inset

 even,
 
\begin_inset Formula $J_{i}$
\end_inset

 and 
\begin_inset Formula $h_{i}$
\end_inset

 random variables.
 The parameters 
\begin_inset Formula $J_{i}$
\end_inset

 are uniform in 
\begin_inset Formula $\left[0,1\right]$
\end_inset

 and 
\begin_inset Formula $h_{i}$
\end_inset

are uniform in 
\begin_inset Formula $\left[-\frac{h}{2},\frac{h}{2}\right]$
\end_inset

.
 This is just a regular RFIM in 1d.
\end_layout

\begin_layout Subsection*
In the classical limit of the RATIC
\end_layout

\begin_layout Standard
This is antiferromagnetic in a constant magnetic field.
 Using a Mattis transformation it becomes a ferromagnetic model in an alternate field
\begin_inset Formula 
\[
\mathcal{H}=-\sum^{L}_{i=1}\left|J_{i}\right|\sigma_{i}\sigma_{i+1}-\sum^{L}_{i=1}\left(-1\right)^{i}h\sigma_{i}
\]

\end_inset

This is not regular RFIM,
 since the fields alternate.
\end_layout

\begin_layout Subsection*
Conclusion
\end_layout

\begin_layout Standard
\align center
It is different and the trick of the RATIC cannot be used as is in the RTLI ...
 Do you agree ?
\end_layout

